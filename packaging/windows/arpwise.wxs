<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows installer for ArpWise (WiX Toolset v5).

  Build with:
    wix build -arch x64 -d Version=0.5.0 -d BinDir=target\x86_64-pc-windows-msvc\release `
              -o ArpWise-0.5.0-windows-x64.msi packaging\windows\arpwise.wxs
  Run from the repository root.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ArpWise"
           Manufacturer="Qoats"
           Version="$(Version)"
           UpgradeCode="6F3A1C52-9B7D-4E08-A1D4-2C5E8B90F713"
           Scope="perMachine"
           Language="1033">

    <SummaryInformation Description="ArpWise - local network scanner" Manufacturer="Qoats" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of ArpWise is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ArpWiseIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ArpWiseIcon" />
    <Property Id="ARPCOMMENTS" Value="Fast, driver-free local network scanner" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ArpWise" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="ArpWise" />
    </StandardDirectory>

    <Feature Id="Main" Title="ArpWise" Level="1">
      <ComponentGroupRef Id="Binaries" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="Binaries" Directory="INSTALLFOLDER">
      <Component Id="GuiComponent">
        <File Id="ArpWiseGui" Source="$(BinDir)\arpwise-gui.exe" KeyPath="yes" />
      </Component>
      <Component Id="CliComponent">
        <File Id="ArpWiseCli" Source="$(BinDir)\arpwise.exe" KeyPath="yes" />
        <!-- Make the `arpwise` command available in every terminal. -->
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
                     Action="set" System="yes" Permanent="no" />
      </Component>
      <Component Id="LicenseComponent">
        <File Id="LicenseFile" Source="LICENSE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ShortcutFolder">
      <Shortcut Id="ApplicationShortcut"
                Name="ArpWise"
                Description="Local network scanner"
                Target="[INSTALLFOLDER]arpwise-gui.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Qoats\ArpWise" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
